# Copy to .env and fill in. Never commit .env.

# ── LLM ───────────────────────────────────────────────────────────────────────
# Switching provider is these three lines and nothing else in the codebase.
#   openai     -> uv add langchain-openai
#   anthropic  -> uv add langchain-anthropic
#   google_genai -> uv add langchain-google-genai
# Two models, because there are two kinds of question.
#
# This one reads the email itself: is this an RFQ, what does the subject say.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_API_KEY=

# And this one reads the attachments: a scanned requisition, a photo of a
# nameplate, a spreadsheet whose columns need naming. It has to be able to see,
# and is usually the stronger of the two.
#
# Each value falls back to its plain counterpart above, so leaving all three
# empty means one model does everything. Set the key only when the provider
# differs; another provider also needs its `langchain-*` package installed.
LLM_DOCUMENT_PROVIDER=
LLM_DOCUMENT_MODEL=
LLM_DOCUMENT_API_KEY=

# Structured output strategy. Verified working values:
#   gpt-5.6-luna -> json_schema   (function_calling returns 400 on this model)
LLM_STRUCTURED_OUTPUT_METHOD=json_schema

# Provider-specific knobs, passed to init_chat_model verbatim. JSON object.
#   OpenAI reasoning models: {"reasoning_effort": "none|low|medium|high"}
#   Anthropic:               {"thinking": {"type": "adaptive"}}
LLM_EXTRA_OPTIONS={"reasoning_effort": "medium"}

# Leave unset unless the model needs them - some models reject them with a 400.
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=2048

LLM_TIMEOUT_S=30.0
LLM_MAX_RETRIES=3

# ── Forwarding ────────────────────────────────────────────────────────────────
# false -> RFQs are classified and labelled but no mail is sent. Turn this on
# On by default, because it is the job: an agent that reads the mailbox and
# forwards nothing is a half-installed agent. Switch it off to watch the labels
# for a while without anything leaving the mailbox.
#
# Requires the Mail.Send application permission with admin consent. Mail.ReadWrite
# does NOT include it.
FORWARD_ENABLED=true

# Attach the filled KASS RFQ form to the forward. Kept as its own switch so the
# form can be turned off without stopping the forwards - the risk it used to
# carry is gone, though: the form is 14 KB of plain .xlsx, well under Exchange
# Online's 35 MB message size and not something Defender strips.
# Off means the desk still gets the customer's email, just without the form.
#
# Needs Mail.ReadWrite IN ADDITION to Mail.Send: a forward carrying a new
# attachment has to be built as a draft first, and that is a write.
FORWARD_WORKBOOK=true

# Where each regional desk's RFQs go. The keys in config/registries.yaml decide
# which one is picked; that file holds only the rules, never an address. A desk
# left blank here is never forwarded to - its mail is labelled for review.
UAE_MAILBOX=
SG_MAILBOX=

# Who is copied on a forward, comma separated. Leave blank for no copy.
#
# WARNING: everyone listed here receives the customer's email in full, with its
# attachments and commercial terms. One external address here sends that data
# outside the company, and a sent email cannot be recalled. Check every entry.
UAE_CC=
SG_CC=

# ── RFQ extraction (Phase 2) ──────────────────────────────────────────────────
# Read every RFQ's attachments, fill the template's fields, write a copy of the
# workbook. Costs a few model calls per RFQ and sends nothing anywhere, so
# unlike FORWARD_ENABLED it is on by default. Off leaves Phase 1 as it was.
EXTRACTION_ENABLED=true

# Read the attachments BEFORE deciding whether the email is an RFQ, so the
# verdict can see what is in them. A requisition in a file is the strongest
# evidence an email is an RFQ, and a body reading "please find attached" carries
# none of it. The cost lands on non-RFQs that arrive with files: one document
# model call per file, where before there were none. No effect while
# EXTRACTION_ENABLED is off - the reader lives in that pipeline.
TRIAGE_READS_ATTACHMENTS=true

# The form the agent fills and sends: the first table of the workbook and
# nothing else, 14 KB, no macro, no master data - the same shape the desk
# produces by hand. Shipped in the image; remade from a finished RFQ with
# `uv run python -m src.tools.make_output_template <file>`.
RFQ_TEMPLATE_PATH=config/rfq_output_template.xlsx

# Where the filled forms land, one per RFQ, named after the decision that
# produced it - which is how a line in the journal and its file find each other.
WORKBOOKS_ENABLED=true
WORKBOOKS_PATH=data/workbooks

# The zone the two timestamp cells are written in. A spreadsheet cell carries no
# zone of its own, so this is a decision rather than a detail: an email arriving
# at 16:33 in Singapore reads 08:33 on the form under UTC. Any IANA name works,
# e.g. Asia/Singapore or Asia/Dubai.
RFQ_TIMEZONE=UTC

# Write what could not be filled in, and why, into the empty block under the
# form. Off leaves the form itself silent - the forwarded email and the decision
# journal say it either way.
RFQ_REMARKS=true

# ── Classification pipeline ───────────────────────────────────────────────────
FAST_PATH_ENABLED=true
MAX_QUOTED_MESSAGES_IN_PROMPT=10
MIN_LATEST_CHARS_FOR_VALID_SPLIT=15

# Starting heuristics only - recalibrate on real traffic.
CONFIDENCE_AUTO_THRESHOLD=0.85
CONFIDENCE_REVIEW_THRESHOLD=0.60

PROMPT_VERSION=v1.0.0
REGISTRIES_PATH=config/registries.yaml

# ── Catalogue ─────────────────────────────────────────────────────────────────
# Our own product list. The desk keeps it in a Google Sheet by hand, so that is
# the source of truth; the agent copies it to a snapshot on disk and indexes it
# in memory. Nothing on the path of an arriving email talks to Google.
#
# The sheet must be published: Share -> General access -> Anyone with the link
# -> Viewer. The export endpoint is fetched without credentials.
# Leave CATALOG_SHEET_ID empty to work from the snapshot alone.
CATALOG_SHEET_ID=
# The tab, as it appears in the sheet's URL after `gid=`.
CATALOG_SHEET_GID=0
CATALOG_SNAPSHOT_PATH=data/catalog/items.csv
CATALOG_REFRESH_MINUTES=10
# Matched against the sheet's own headings, ignoring case and spacing.
#
# Two description columns, and the difference between them is the whole of the
# matching. Read both comments before changing either.
CATALOG_CODE_COLUMN=Item Code
# SEARCHED. How a customer once asked for this product, and the only column the
# search reads: a line of an RFQ is written by a customer, so what it resembles
# is another customer's wording - not our own shelf description.
CATALOG_SEARCH_COLUMN=Customer Description
# SHOWN. Our own name for the product. Never searched: it is what the matching
# screen puts in `Internal item description` and what the record keeps as
# `item_description`. The sheet has sixteen columns; this says which one that is.
CATALOG_SHOWN_COLUMN=Item Description / SSG Description
# Optional. A customer who quotes a code at all usually quotes their own, so
# this is a second way into the same item - never a second answer.
CATALOG_CUSTOMER_CODE_COLUMN=Customer Code
# How much of a line has to appear in an item's own customer wording before the
# code that named it is taken at its word. Below it the code is dropped and the
# catalogue is searched by description instead.
MATCHING_AGREEMENT_PERCENT=80.0
# How many candidates one RFQ line is narrowed down to. The ceiling on
# everything after it: nothing can choose an item it was never shown. Five is
# where `catalog_recall` stops improving - @5 and @20 score the same.
CATALOG_SHORTLIST=5
# Match each line of an RFQ against the catalogue: two model calls per RFQ,
# whatever its size. The result goes into the record, not into the form the
# desk receives. Off leaves everything else untouched.
MATCHING_ENABLED=true

# ── The browser ───────────────────────────────────────────────────────────────
# Origins allowed to call this API from a page, comma separated. The RFQ screens
# are served from a different host than this API, and a browser refuses that
# unless the API names the origin.
#
# Empty means no browser may call it at all - the right default for an API that
# otherwise only answers webhooks. Do not put `*` here: it serves customer mail,
# and a wildcard cannot carry credentials anyway.
#
# CORS_ORIGINS=https://gray-cliff-0b1cd8403.5.azurestaticapps.net,http://localhost:5173
CORS_ORIGINS=

# ── Records and files ─────────────────────────────────────────────────────────
# One record per email: the verdict, what was read out of the RFQ, the matching
# and the delivery. This is what the front end reads - GET /api/v1/quotes serves
# it - and it holds real customer mail, which is why none of it is in git.
#
# The journal further down is a different thing and both are kept: it is
# append-only and says how each answer was reached; a record is rewritten as the
# email moves and says where the email stands now.
#
# `postgres` is the default and what everything runs on: the record in the
# database, the bytes in a blob container. `folder` is the other implementation,
# both halves on disk, and it exists so that `tests/test_records_contract.py`
# can ask the same questions of both and compare - which is what caught three
# bugs in the database one. Nothing in production sets this.
RECORDS_STORE=postgres

# Postgres. `+asyncpg` is the driver the service connects with; Alembic swaps
# it for `+psycopg` on its own, because migrations run synchronously.
#
# Two things bite here:
#   - `?ssl=require`, NOT `?sslmode=require`. asyncpg reads `ssl`; psycopg and
#     psql read `sslmode`. Azure refuses an unencrypted connection either way.
#   - a password with @ : / ? # in it. It happens to survive as written, but
#     percent-encode it anyway (@ is %40) - psql and the Azure portal split on
#     the first @ where this does not.
#
# Local, from docker-compose.yml:
DATABASE_URL=postgresql+asyncpg://rfq:rfq_local_dev@localhost:5433/rfq
# Azure, for the deployed container:
# DATABASE_URL=postgresql+asyncpg://rfqadmin:PASSWORD@rfq-workflow-db.postgres.database.azure.com:5432/rfq-db?ssl=require
#
# One uvicorn worker handling a webhook at a time needs no more, and every
# connection is one the Burstable tier has to hold open.
DB_POOL_SIZE=5

# Read by docker-compose.yml, never by the code, and only for the local
# container: they create the database at its FIRST start. Change them later and
# you also have to `docker compose down -v`, because the volume remembers the
# old ones. Not needed in the deployed container - Postgres is in Azure there.
POSTGRES_USER=rfq
POSTGRES_PASSWORD=rfq_local_dev
POSTGRES_DB=rfq

# The blob container the attachments and the filled forms go to. The container
# is private and stays private: the browser asks the API for a file and the API
# fetches it, so a link to an attachment is never a link anybody else can follow.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=rfq-files
# Where the bytes go when there is no connection string above - a folder that
# answers exactly as the container does. That is what the tests use, and what a
# first checkout runs on with nothing configured.
BLOB_FOLDER_PATH=data/blobs

# Only read when RECORDS_STORE=folder.
DATABASE_ENABLED=true
DATABASE_PATH=Database
# Keep the attachments' bytes, not only their names. Off saves the disk and
# leaves the records intact. Only files the pipeline downloaded anyway are ever
# written: an email the cheap rules answer is never downloaded, and the record
# says so beside each name.
DATABASE_KEEP_ATTACHMENTS=true

# ── Decision log ──────────────────────────────────────────────────────────────
PERSIST_DECISIONS=true
DECISIONS_LOG_PATH=data/decisions.jsonl
# Email bodies contain commercial terms and personal data. Keep false in production.
# Covers the body only: the model quotes the email in its own `evidence`, so the
# journal holds customer text either way. Treat the file as confidential.
LOG_EMAIL_BODIES=false

# Our own lines. INFO is one readable line per stage of an email; DEBUG adds
# the individual model calls, the fast-path rule that fired, and every parser
# that declined a file.
LOG_LEVEL=INFO

# The libraries, pinned separately - `httpx` logs a line per HTTP request and
# there are up to sixteen per RFQ, `pdfminer` logs several per page. Raise to
# INFO or DEBUG only while chasing something inside a provider or Graph.
LOG_LIBRARY_LEVEL=WARNING

# ── Microsoft Entra ID / Graph ────────────────────────────────────────────────
# false -> serve HTTP only: no ngrok, no Graph subscription, no retries in the log.
# The /classify endpoint works the same either way.
OUTLOOK_ENABLED=true
APPLICATION_CLIENT_ID=
DIRECTORY_TENANT_ID=
CLIENT_SECRET_VALUE=
MAILBOX_ADDRESS=

# Public HTTPS URL Graph pushes notifications to (ngrok during development).
NGROK_URL=
# Any random secret. Graph echoes it back so we can reject forged notifications.
WEBHOOK_CLIENT_STATE=

SUBSCRIPTION_EXPIRATION_MINUTES=60
SUBSCRIPTION_RENEWAL_MARGIN_MINUTES=15
